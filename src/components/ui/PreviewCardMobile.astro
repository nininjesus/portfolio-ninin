---
import '../../styles/components/preview-card.css';
import Btn from '../primitives/Btn.astro';

interface Props {
  id: string;
  title: string;
  description: string;
  year: number;
  category: string;
  thumbnailSrc?: string;
  urlView?: string;
  urlPreview?: string;
}

const { id, title, description, thumbnailSrc, urlView, urlPreview } = Astro.props;
---

<article class="preview-card-mobile" data-project-id={id}>
  <div class="preview-thumbnail-mobile">
    {thumbnailSrc ? (
      <img src={thumbnailSrc} alt={`Thumbnail de ${title}`} />
    ) : (
      <div class="thumbnail-placeholder"></div>
    )}
  </div>
  
  <div class="preview-content-mobile">
    <div class="preview-info">
      <h3 class="preview-title">{title}</h3>
      <p class="preview-description">{description}</p>
    </div>
    
    <div class="preview-actions-mobile">
      {urlView && <Btn label=" Ver " ariaLabel={`Ver ${title}`} />}
      {urlPreview && <Btn label=" Preview " ariaLabel={`Preview de ${title}`} />}
    </div>
  </div>
</article>
