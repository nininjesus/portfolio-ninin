---
import '../../styles/components/preview-card.css';
import Btn from '../primitives/Btn.astro';
import { t } from '../../i18n/index';

interface Props {
  lang?: 'es' | 'en';
  projectId: string;
  title: string;
  category: string;
  year: string | number;
  repo?: string;
}

const { lang = 'es', projectId, title, category, year, repo = '#' } = Astro.props;

// ID de la ventana que este botón debe abrir
const windowId = `project-window-${projectId}`;
const viewLabel = t(lang, 'ui.view');
const ariaViewLabel = t(lang, 'ui.viewDetails').replace('{0}', title);
---

<article class="preview-card" data-cli-line="reveal">
  <div class="card-thumb" aria-hidden="true"></div>

  <div class="card-info">
    <h3 class="card-title">{title}</h3>
    <p class="card-meta">{category} | {year}</p>
  </div>

  <div class="card-actions">
    <Btn
      label={viewLabel}
      data-target-window={windowId}
      ariaLabel={ariaViewLabel}
    />
    <Btn label="Preview" href={repo} variant="secondary" />
  </div>
</article>
