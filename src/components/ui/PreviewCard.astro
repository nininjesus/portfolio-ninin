---
import '../../styles/components/preview-card.css';
import Btn from '../primitives/Btn.astro';

interface Props {
  projectId: string;
  title: string;
  category: string;
  year: string | number;
  repo?: string;
}

const { projectId, title, category, year, repo = '#' } = Astro.props;

// ID de la ventana que este botón debe abrir
const windowId = `project-window-${projectId}`;
---

<article class="preview-card" data-cli-line="reveal">
  <div class="card-thumb" aria-hidden="true"></div>

  <div class="card-info">
    <h3 class="card-title">{title}</h3>
    <p class="card-meta">{category} | {year}</p>
  </div>

  <div class="card-actions">
    <Btn
      label="Ver"
      data-target-window={windowId}
      ariaLabel={`Ver detalles de ${title}`}
    />
    <Btn label="Preview" href={repo} variant="secondary" />
  </div>
</article>
