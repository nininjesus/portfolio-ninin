---
import '../../styles/components/panel-nav.css';
import NavOption from './NavOption.astro';
import { navItems } from '../../data/navigation.js';

interface Props {
  activeSectionId?: string;
}

const { activeSectionId = 'bienvenida' } = Astro.props;
---

<nav class="panel-nav" aria-label="Navegación principal" id="panel-nav">
  <header class="panel-nav-header">
    <h2 class="panel-nav-title">NAV.EXE</h2>
  </header>
  <ul class="panel-nav-list">
    {navItems.map(item => (
      <NavOption 
        index={item.index} 
        label={item.label} 
        sectionId={item.sectionId} 
        isActive={activeSectionId === item.sectionId} 
      />
    ))}
  </ul>
</nav>
