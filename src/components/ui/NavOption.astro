---
import '../../styles/components/nav-option.css';

interface Props {
  index: number;
  label: string;
  sectionId: string;
  isActive?: boolean;
}

const { index, label, sectionId, isActive = false } = Astro.props;
---

<li class="nav-item">
  <a 
    href={`#${sectionId}`} 
    class:list={['nav-option', { 'is-active': isActive }]}
    aria-current={isActive ? 'page' : undefined}
    data-nav-link
  >
    <span class="nav-option-index" aria-hidden="true">[{index}]</span>
    <span class="nav-option-label">{label}</span>
  </a>
</li>
