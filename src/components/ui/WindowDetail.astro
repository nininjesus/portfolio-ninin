---
import '../../styles/components/window-detail.css';
import Btn from '../primitives/Btn.astro';

interface Props {
  id: string;
  projectId: string;
  title: string;
  category: string;
  year: string | number;
  description: string;
  urlView?: string;
  urlPreview?: string;
}

const {
  id,
  projectId,
  title,
  category,
  year,
  description,
  urlView,
  urlPreview,
} = Astro.props;

// Título estilo OS
const osTitle = projectId.toUpperCase() + '.EXE';

// Comprobar si las URLs son "reales" o placeholders internos
const hasView    = urlView    && urlView    !== '#' && !urlView.startsWith('#');
const hasPreview = urlPreview && urlPreview !== '#' && !urlPreview.startsWith('#');
---

<article
  id={id}
  class="window-detail"
  role="dialog"
  aria-modal="true"
  aria-labelledby={`${id}-title`}
  data-state="hidden"
>
  <header class="window-detail-header">
    <div class="window-detail-title-group">
      <span class="window-detail-indicator" aria-hidden="true">▒▒▒</span>
      <h2 id={`${id}-title`} class="window-detail-title">{osTitle}</h2>
    </div>

    <div class="window-controls" role="group" aria-label="Controles de ventana">
      <button
        class="window-ctrl window-ctrl--minimize"
        type="button"
        aria-label="Minimizar ventana"
        data-action="minimize"
      >[_]</button>
      <button
        class="window-ctrl window-ctrl--maximize"
        type="button"
        aria-label="Maximizar ventana"
        data-action="maximize"
      >[□]</button>
      <button
        class="window-ctrl window-ctrl--close"
        type="button"
        aria-label="Cerrar ventana"
        data-action="close"
      >[X]</button>
    </div>
  </header>

  <div class="window-detail-content">
    <div class="project-detail">
      <p class="project-detail-line">
        <span class="detail-key">&gt; NOMBRE:</span>
        <span class="detail-val"> {title}</span>
      </p>
      <p class="project-detail-line">
        <span class="detail-key">&gt; CATEGORIA:</span>
        <span class="detail-val"> {category}</span>
      </p>
      <p class="project-detail-line">
        <span class="detail-key">&gt; AÑO:</span>
        <span class="detail-val"> {year}</span>
      </p>

      <hr class="project-detail-separator" aria-hidden="true" />

      <p class="project-detail-desc">{description}</p>

      {(hasView || hasPreview) && (
        <div class="project-detail-actions">
          {hasView && (
            <Btn
              href={urlView}
              variant="default"
              label="Ver Proyecto"
              target="_blank"
              rel="noopener noreferrer"
            />
          )}
          {hasPreview && (
            <Btn
              href={urlPreview}
              variant="secondary"
              label="Preview"
              ariaLabel={`Vista previa de ${title}`}
              target="_blank"
              rel="noopener noreferrer"
            />
          )}
        </div>
      )}
    </div>
  </div>
</article>
