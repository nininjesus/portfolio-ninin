---
import '../../styles/components/topbar.css';
import { t } from '../../i18n/index';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const ariaLangToggle = t(lang, 'aria.langToggle');
---

<header class="topbar" role="banner">
  <div class="topbar-left">
    <a href="#bienvenida" class="os-title" data-nav-link>NININTRON_OS</a>
  </div>
  
  <div class="topbar-right">
    <span class="user-label">[usr:ninin]</span>
    
    <!-- Language Switcher -->
    <nav class="lang-switcher" aria-label={ariaLangToggle}>
      <a href="/es" class={`lang-btn ${lang === 'es' ? 'is-active' : ''}`} aria-current={lang === 'es' ? 'true' : undefined}>[ES]</a>
      <a href="/en" class={`lang-btn ${lang === 'en' ? 'is-active' : ''}`} aria-current={lang === 'en' ? 'true' : undefined}>[EN]</a>
    </nav>

    <!-- CRT Monitor Effect Toggle -->
    <button
      type="button"
      id="crt-toggle-btn"
      class="crt-toggle"
      aria-pressed="false"
      aria-label="Activar efecto de monitor CRT"
    >
      <span aria-hidden="true">[CRT]</span>
    </button>
    <!-- Renderizamos un botón nativo para inyectar directamente atributos aria vitales -->
    <button 
      type="button" 
      id="menu-btn"
      class="menu-toggle"
      aria-expanded="false" 
      aria-controls="panel-nav" 
      aria-label="Abrir menú de navegación"
    >
      <span aria-hidden="true">[= MENU]</span>
    </button>
  </div>
</header>
