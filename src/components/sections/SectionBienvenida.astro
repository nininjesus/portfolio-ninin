---
import '../../styles/components/section-bienvenida.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
---

<Panel sectionId="bienvenida" ariaLabel="Sección de bienvenida" title="MAIN.EXE">
  <PanelMain>
    <div class="bienvenida-content">
      <img src="/images/ninin-logo.svg" alt="NININTRON Logo ASCII" class="ascii-art-logo" aria-hidden="true" />
      <div class="bienvenida-text">
        <h1 class="os-name">NININTRON_OS</h1>
        <h2 class="os-version">V1.0</h2>
      </div>
    </div>
  </PanelMain>
</Panel>
