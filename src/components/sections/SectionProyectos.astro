---
import '../../styles/components/section-proyectos.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Separator from '../primitives/Separator.astro';
import PreviewCard from '../ui/PreviewCard.astro';
import PreviewCardMobile from '../ui/PreviewCardMobile.astro';
import WindowDetail from '../ui/WindowDetail.astro';
import { projectsList } from '../../data/projects.js';
---

<Panel sectionId="la-proyectos" ariaLabel="Proyectos">
  <PanelMain>
    <div class="proyectos-container">
      <Separator variant="default" />
      
      <ul class="proyectos-list">
        {projectsList.map((project, index) => (
          <li>
            <PreviewCard {...project} />
            <PreviewCardMobile {...project} />
            {index < projectsList.length - 1 && <Separator variant="default" />}
          </li>
        ))}
      </ul>
      
      <Separator variant="default" />
    </div>
  </PanelMain>
  
  <WindowDetail title="DETALLE_PROYECTO.EXE">
    <p>Selecciona un proyecto para ver sus detalles.</p>
  </WindowDetail>
</Panel>
