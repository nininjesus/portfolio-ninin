---
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import PreviewCard from '../ui/PreviewCard.astro';
import WindowDetail from '../ui/WindowDetail.astro';
import { projects } from '../../data/projects.js';
import TerminalHeader from '../primitives/TerminalHeader.astro';
import { t } from '../../i18n/index';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const sectionTitle = t(lang, 'nav.proyectos.label').toUpperCase() + '.EXE';
const commandTitle = 'ls ' + t(lang, 'nav.proyectos.label');
const ariaLabel = t(lang, 'aria.proyectos');
---

<Panel sectionId="proyectos" ariaLabel={ariaLabel} title={sectionTitle}>
  <PanelMain>

    <TerminalHeader command={commandTitle} />

    <div class="proyectos-list">
      {projects.map((project, index) => {
        const pTrans = t(lang, 'projects.' + project.id);
        return (
        <>
          <PreviewCard
            lang={lang}
            projectId={project.id}
            title={pTrans.title}
            category={pTrans.category}
            year={project.year}
            repo={project.urlPreview}
          />
          {index < projects.length - 1 && (
            <hr class="terminal-separator" data-cli-line="reveal" />
          )}
        </>
      )})}
    </div>

  </PanelMain>

  <!-- Capa de ventanas OS, ahora contenida localmente dentro de Proyectos -->
  <div id="windows-layer">
    {projects.map((project) => {
      const pTrans = t(lang, 'projects.' + project.id);
      return (
      <WindowDetail
        lang={lang}
        id={`project-window-${project.id}`}
        projectId={project.id}
        title={pTrans.title}
        category={pTrans.category}
        year={project.year}
        description={pTrans.description}
        urlView={project.urlView}
        urlPreview={project.urlPreview}
      />
    )})}
  </div>
</Panel>
