---
import '../../styles/components/section-proyectos.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import WindowDetail from '../ui/WindowDetail.astro';
import PreviewCard from '../ui/PreviewCard.astro';
import { projects } from '../../data/projects.js';
---

<Panel sectionId="ls-proyectos" ariaLabel="Sección de proyectos" title="PROYECTOS.EXE">
  <PanelMain>
    
    <div class="terminal-command-container">
      <span class="prompt-symbol">$</span>
      <span class="command-text">ls proyectos</span>
    </div>
    
    <div class="terminal-cursor-container">
      <span class="cursor-symbol">&gt;</span>
      <span class="cursor-blink">_</span>
    </div>

    <div class="proyectos-list">
      {projects.map((project, index) => (
        <>
          <PreviewCard 
            title={project.title}
            category={project.category}
            year={project.year}
            link={project.link}
            repo={project.repo}
          />
          {index < projects.length - 1 && (
            <hr class="project-separator" />
          )}
        </>
      ))}
    </div>

  </PanelMain>
</Panel>
