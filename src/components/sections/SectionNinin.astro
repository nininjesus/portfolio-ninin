---
import '../../styles/components/section-ninin.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Prompt from '../primitives/Prompt.astro';
import Output from '../primitives/Output.astro';

const socialLinks = [
  { name: 'GitHub', url: 'https://github.com', icon: '/icons/github.svg' },
  { name: 'LinkedIn', url: 'https://linkedin.com', icon: '/icons/linkedin.svg' }
];
---

<Panel sectionId="ninin" ariaLabel="Sobre Mí">
  <PanelMain>
    <div class="ninin-container">
      <div class="ninin-content">
        <Prompt command="ninin" />
        <Output showCursor={true} />
        
        <blockquote class="ninin-quote">
          <p>"Necesito algo mas potente que el cafe. Por favor".</p>
          <footer>Jesus Ninin</footer>
        </blockquote>
        
        <nav aria-label="Redes sociales" class="ninin-social">
          {socialLinks.map(link => (
            <a href={link.url} target="_blank" rel="noopener noreferrer" aria-label={`Perfil de ${link.name} de Jesús Ninin`}>
              <img src={link.icon} alt={`${link.name} icon`} width="32" height="32" class="social-icon" />
            </a>
          ))}
        </nav>
      </div>

      <figure class="ninin-photo-container">
        <img src="/images/ninin-photo.svg" alt="Jesús Ninin" class="ascii-photo" />
      </figure>
    </div>
  </PanelMain>
</Panel>
