---
import '../../styles/components/section-ninin.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import TerminalHeader from '../primitives/TerminalHeader.astro';

// Iconos de GitHub y LinkedIn servidos como SVGs estáticos desde /icons/.

import { nininQuotes } from '../../data/nininQuotes.js';
---

<Panel sectionId="ninin" ariaLabel="Sección Ninin" title="NININ.EXE">
  <PanelMain>
    
    <TerminalHeader command="ninin" />

    <div class="ninin-content">
      <div class="ninin-text-col">
        <p class="ninin-quote" id="dynamic-quote" data-cli-line="reveal">
          {nininQuotes[0]}
        </p>
        <p class="ninin-name" data-cli-line="reveal">Jesus Ninin</p>
        
        <div class="ninin-social-links" data-cli-line="reveal">
          <!-- Icono GitHub -->
          <a href="https://github.com/nininjesus" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Perfil de GitHub">
            <img src="/icons/github.svg" alt="" aria-hidden="true" width="24" height="24" />
          </a>
          <!-- Icono LinkedIn -->
          <a href="https://www.linkedin.com/in/ninin-dev" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Perfil de LinkedIn">
            <img src="/icons/linkedin.svg" alt="" aria-hidden="true" width="24" height="24" />
          </a>
        </div>
      </div>
      
      <div class="ninin-photo-col">
        <img src="/images/ninin-photo.svg" alt="" aria-hidden="true" class="ascii-photo" width="1192" height="1195" loading="eager" fetchpriority="high" data-cli-line="reveal" />
      </div>
    </div>
    
  </PanelMain>
</Panel>

<script>
  import { nininQuotes } from '../../data/nininQuotes.js';
  import { rotateText } from '../../scripts/textRotator.js';

  // Iniciar la rotación de texto con las frases, cambiando cada 5 segundos
  rotateText('dynamic-quote', nininQuotes, 5000);
</script>