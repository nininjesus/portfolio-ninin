---
import { Image } from 'astro:assets';
import '../../styles/components/section-ninin.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Prompt from '../primitives/Prompt.astro';

// Usamos el icono de GitHub y LinkedIn de la librería lucidide si estuviera, 
// o un simple texto/SVG para igualar el arte rojo. En el diseño son iconos rojos enormes.

import { nininQuotes } from '../../data/nininQuotes.js';
---

<Panel sectionId="ninin" ariaLabel="Sección Ninin" title="NININ.EXE">
  <PanelMain>
    
    <div class="terminal-command-container">
      <Prompt command="ninin" />
    </div>
    
    <div class="terminal-cursor-container">
      <span class="cursor-symbol">&gt;</span>
      <span class="cursor-blink">_</span>
    </div>

    <div class="ninin-content">
      <div class="ninin-text-col">
        <p class="ninin-quote" id="dynamic-quote">
          {nininQuotes[0]}
        </p>
        <p class="ninin-name">Jesus Ninin</p>
        
        <div class="ninin-social-links">
          <!-- Icono GitHub -->
          <a href="https://github.com/nininjesus" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Perfil de GitHub">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M12 2C6.477 2 2 6.477 2 12c0 4.42 2.865 8.166 6.839 9.489.5.092.682-.217.682-.482 0-.237-.008-.866-.013-1.7-2.782.604-3.369-1.34-3.369-1.34-.454-1.156-1.11-1.464-1.11-1.464-.908-.62.069-.608.069-.608 1.003.07 1.531 1.03 1.531 1.03.892 1.529 2.341 1.087 2.91.831.092-.646.35-1.086.636-1.336-2.22-.253-4.555-1.11-4.555-4.943 0-1.091.39-1.984 1.029-2.683-.103-.253-.446-1.27.098-2.647 0 0 .84-.269 2.75 1.025A9.578 9.578 0 0112 6.836c.85.004 1.705.114 2.504.336 1.909-1.294 2.747-1.025 2.747-1.025.546 1.379.203 2.394.1 2.647.64.699 1.028 1.592 1.028 2.683 0 3.842-2.339 4.687-4.566 4.935.359.309.678.919.678 1.852 0 1.336-.012 2.415-.012 2.743 0 .267.18.578.688.48C19.138 20.161 22 16.416 22 12c0-5.523-4.477-10-10-10z"/>
            </svg>
          </a>
          <!-- Icono LinkedIn -->
          <a href="https://www.linkedin.com/in/ninin-dev" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Perfil de LinkedIn">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="currentColor">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </a>
        </div>
      </div>
      
      <div class="ninin-photo-col">
        <Image src="/images/ninin-photo.svg" alt="Jesús Ninin Foto ASCII" class="ascii-photo" width={1192} height={1195} loading="eager" fetchpriority="high" />
      </div>
    </div>
    
  </PanelMain>
</Panel>

<script>
  import { nininQuotes } from '../../data/nininQuotes.js';
  import { rotateText } from '../../scripts/textRotator.js';

  // Iniciar la rotación de texto con las frases, cambiando cada 5 segundos
  rotateText('dynamic-quote', nininQuotes, 5000);
</script>