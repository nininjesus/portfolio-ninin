---
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import TerminalHeader from '../primitives/TerminalHeader.astro';
import { t } from '../../i18n/index';
import { GITHUB_URL, LINKEDIN_URL, AUTHOR_NAME } from '../../data/site.js';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const quotes = t(lang, 'ninin.quotes');
---

<Panel sectionId="ninin" ariaLabel={t(lang, 'aria.ninin')} title="NININ.EXE">
  <PanelMain>
    
    <TerminalHeader command="ninin" />

    <div class="ninin-content">
      <div class="ninin-text-col">
        <p class="ninin-quote" id="dynamic-quote" data-cli-line="reveal" data-quotes={JSON.stringify(quotes)}>
          {quotes[0]}
        </p>
        <p class="ninin-name" data-cli-line="reveal">{AUTHOR_NAME}</p>
        
        <div class="ninin-social-links" data-cli-line="reveal">
          <!-- Icono GitHub -->
          <a href={GITHUB_URL} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Perfil de GitHub">
            <img src="/icons/github.svg" alt="" aria-hidden="true" width="24" height="24" />
          </a>
          <!-- Icono LinkedIn -->
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Perfil de LinkedIn">
            <img src="/icons/linkedin.svg" alt="" aria-hidden="true" width="24" height="24" />
          </a>
        </div>
      </div>
      
      <div class="ninin-photo-col">
        <img src="/images/ninin-photo.svg" alt="" aria-hidden="true" class="ascii-photo" width="1192" height="1195" loading="lazy" data-cli-line="reveal" />
      </div>
    </div>
    
  </PanelMain>
</Panel>

<script>
  import { rotateText } from '../../scripts/textRotator.js';

  const quoteElement = document.getElementById('dynamic-quote');
  if (quoteElement && quoteElement.dataset.quotes) {
    try {
      const quotes = JSON.parse(quoteElement.dataset.quotes);
      rotateText('dynamic-quote', quotes, 5000);
    } catch (e) {
      console.error(e);
      quoteElement.textContent = '"¿Como hago para ser millonario en menos de 2 minutos? Buscar Google".';
    }
  }
</script>