---
import '../../styles/components/section-contacto.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Btn from '../primitives/Btn.astro';
import Prompt from '../primitives/Prompt.astro';
import Output from '../primitives/Output.astro';
import InputLine from '../primitives/InputLine.astro';
---

<Panel sectionId="contacto" ariaLabel="Sección de contacto" title="CONTACTO.SH">
  <PanelMain>
    <div class="contacto-wrapper">
      <Prompt command='mail -s "CONTACTO" nj13072004@gmail.com' />
      
      <div class="contacto-spacing">
        <Output text="[Escriba su mensaje]" />
      </div>

      <form class="contacto-form" action="mailto:nj13072004@gmail.com" method="post" enctype="text/plain">
        
        <InputLine label="NOMBRE:" name="nombre" />
        <InputLine label="EMAIL:" name="email" type="email" />
        <InputLine label="ASUNTO:" name="asunto" />

        <div class="contacto-spacing">
          <Output text="Mensaje:" />
        </div>

        <!-- Mantenemos el textarea como pidió el usuario, pero lo adaptamos a la estructura visual -->
        <div class="form-group textarea-group">
          <span class="bracket">[</span>
          <textarea class="form-textarea" id="mensaje" name="mensaje" rows="3" aria-label="Mensaje" autocomplete="off"></textarea>
          <span class="bracket">]</span>
        </div>

        <div class="form-actions">
          <Btn label="ENVIAR" type="submit" />
        </div>

      </form>
    </div>
  </PanelMain>
</Panel>
