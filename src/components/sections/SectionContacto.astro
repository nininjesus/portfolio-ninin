---
import '../../styles/components/section-contacto.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Prompt from '../primitives/Prompt.astro';
import Output from '../primitives/Output.astro';
import InputLine from '../primitives/InputLine.astro';
import Btn from '../primitives/Btn.astro';
---
<Panel sectionId="mail-contacto" ariaLabel="Contacto">
  <PanelMain>
    <div class="contacto-container">
      <Prompt command="mail-contacto" />
      <Output text="Iniciando protocolo de mensajeria..." showCursor={true} />
      
      <form class="contacto-form" action="#" method="POST" onsubmit="event.preventDefault();">
        <InputLine 
          label="Nombre" 
          name="name" 
          type="text" 
          required={true} 
          placeholder="Escribe tu nombre..."
        />
        <InputLine 
          label="Email" 
          name="email" 
          type="email" 
          required={true} 
          placeholder="tucorreo@ejemplo.com"
        />
        <InputLine 
          label="Mensaje" 
          name="message" 
          type="textarea" 
          required={true} 
          placeholder="¿En qué te puedo ayudar?"
        />
        <div class="contacto-actions">
          <Btn label=" Enviar " type="submit" variant="active" />
        </div>
      </form>
    </div>
  </PanelMain>
</Panel>
