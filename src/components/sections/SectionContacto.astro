---
import '../../styles/components/section-contacto.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Btn from '../primitives/Btn.astro';
import Prompt from '../primitives/Prompt.astro';
import Output from '../primitives/Output.astro';
import InputLine from '../primitives/InputLine.astro';
import { t } from '../../i18n/index';

interface Props {
  lang?: 'es' | 'en';
}

const { lang = 'es' } = Astro.props;
const contactData = t(lang, 'contact');
const sectionTitle = t(lang, 'nav.contacto.label').toUpperCase() + '.SH';
const ariaLabel = lang === 'en' ? 'Contact section' : 'Sección de contacto';
const ariaMessage = lang === 'en' ? 'Message' : 'Mensaje';
---

<Panel sectionId="contacto" ariaLabel={ariaLabel} title={sectionTitle}>
  <PanelMain>
    <div class="contacto-wrapper">
      <Prompt command={contactData.command} />
      
      <div class="contacto-spacing">
        <Output text={contactData.prompt} />
      </div>

      <form 
        class="contacto-form" 
        id="form" 
        action="https://api.web3forms.com/submit" 
        method="POST" 
        data-cli-line="reveal"
        data-msg-sending={contactData.status.sending}
        data-msg-error={contactData.status.error}
        novalidate>
        
        <!-- Add your Web3Forms Access Key -->
        <input type="hidden" name="access_key" value={import.meta.env.PUBLIC_WEB3FORMS_KEY} />
        <input type="checkbox" name="botcheck" class="visually-hidden" tabindex="-1" aria-hidden="true" />

        <InputLine label={contactData.name} name="name" required={true} />
        <InputLine label={contactData.email} name="email" type="email" required={true} />
        <InputLine label={contactData.subject} name="subject" required={true} />

        <div class="contacto-spacing">
          <Output text={contactData.messageLabel} />
        </div>

        <InputLine name="message" type="textarea" required={true} autocomplete="off" ariaLabel={ariaMessage} />

        <div class="form-actions">
          <Btn label={contactData.submit} type="submit" />
        </div>

        <div id="result-wrapper" class="form-result-wrapper">
          <Output contentId="result" text="" />
        </div>
      </form>
    </div>
  </PanelMain>
</Panel>

<script>
  import '../../scripts/contact-form.js';
</script>
