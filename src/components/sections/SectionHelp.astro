---
import '../../styles/components/section-help.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Prompt from '../primitives/Prompt.astro';
import Output from '../primitives/Output.astro';
import { navItems } from '../../data/navigation.js';
---

<Panel sectionId="man-ayuda" ariaLabel="Manual de Ayuda">
  <PanelMain>
    <div class="help-container">
      <Prompt command="man ayuda" />
      <Output text="MANUAL DE USUARIO (NININ_OS v1.0)" />
      <Output text="COMANDOS DISPONIBLES:" />
      
      <ul class="help-commands-list" aria-label="Lista de comandos">
        {navItems.map((item, index) => (
          <li>
            <Output text={`[${item.index}] ${item.label.padEnd(15, '.')} ${item.description}`} />
          </li>
        ))}
      </ul>
      
      <br />
      <Output text="NOTA: Puedes ejecutar cualquiera de estos comandos haciendo" />
      <Output text="clic directamente en el panel de navegación izquierdo (NAV.EXE)" showCursor={true} />
    </div>
  </PanelMain>
</Panel>
