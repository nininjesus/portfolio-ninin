---
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Prompt from '../primitives/Prompt.astro';
import Output from '../primitives/Output.astro';
import { helpData } from '../../data/help.js';
---

<Panel sectionId="ayuda" ariaLabel="Sección de ayuda" title="AYUDA.TXT">
  <PanelMain>
    
    <div class="terminal-command-container">
      <Prompt command="man ayuda" />
    </div>

    <div class="terminal-content-list">
      <hr class="terminal-separator" />

      {helpData.map((line, index) => {
        if (line === "---") return <hr class="terminal-separator" />;
        
        // Add margin-bottom to specific lines to match the original design without extra divs
        const needsMargin = line.startsWith("COMANDOS DISPONIBLES:") || line.startsWith("[5] ayuda");
        const className = needsMargin ? "margin-bottom" : "";
        
        return <Output text={line} class={className} />;
      })}
    </div>
    
  </PanelMain>
</Panel>
