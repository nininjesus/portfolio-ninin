---
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Output from '../primitives/Output.astro';
import TerminalHeader from '../primitives/TerminalHeader.astro';
import { aboutData } from '../../data/about.js';
---

<Panel sectionId="sobre-mi" ariaLabel="Sección sobre mí" title="SOBRE_MI.TXT">
  <PanelMain>
    
    <TerminalHeader command="cat /sobre_mi.txt" />
    
    <div class="terminal-content-list">
      <hr class="terminal-separator" />
      {aboutData.map((line) => (
        line === "---" ? <hr class="terminal-separator" /> : <Output text={line} />
      ))}
    </div>
    
  </PanelMain>
</Panel>
