---
import '../../styles/components/section-about.css';
import Panel from '../ui/Panel.astro';
import PanelMain from '../ui/PanelMain.astro';
import Separator from '../primitives/Separator.astro';
import Output from '../primitives/Output.astro';

const aboutData = [
  "NOMBRE: JESÚS NININ",
  "ROL: DESARROLLADOR FULL STACK",
  "UBICACION: GUACARA",
  "SKILLS: FRONTEND (REACT, NEXT.JS, ANGULAR, BLAZOR)",
  "SKILLS: BACKEND (.NET, C#, NODE.JS, EXPRESS.JS)",
  "SKILLS: DATABASES (MYSQL, POSTGRESQL, MONGODB)"
];
---

<Panel sectionId="sobre-mi" ariaLabel="Experiencia y Habilidades">
  <PanelMain>
    <div class="about-container">
      <Separator variant="default" />
      
      <div class="about-data-list">
        {aboutData.map((data, index) => (
          <Output text={data} showCursor={index === aboutData.length - 1} />
        ))}
      </div>
      
    </div>
  </PanelMain>
</Panel>
