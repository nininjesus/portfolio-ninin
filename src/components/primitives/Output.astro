---
import '../../styles/components/output.css';
import Cursor from './Cursor.astro';

interface Props {
  text?: string;
  showCursor?: boolean;
  contentId?: string;
  class?: string;
  isStatic?: boolean;
}

const { text, showCursor = false, contentId, class: className, isStatic = false } = Astro.props;
---

<div class={`cmd-output ${className || ''}`.trim()} data-cli-line={isStatic ? undefined : "reveal"}>
  <span class="cmd-output-symbol" aria-hidden="true">&gt;</span>
  <span class="cmd-output-content" id={contentId}>
    {text ? text : <slot />}
    {showCursor && <Cursor />}
  </span>
</div>
