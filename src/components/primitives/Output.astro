---
import '../../styles/components/output.css';
import Cursor from './Cursor.astro';

interface Props {
  text?: string;
  showCursor?: boolean;
  contentId?: string;
}

const { text, showCursor = false, contentId } = Astro.props;
---

<div class="cmd-output">
  <span class="cmd-output-symbol" aria-hidden="true">&gt;</span>
  <span class="cmd-output-content" id={contentId}>
    {text ? text : <slot />}
    {showCursor && <Cursor />}
  </span>
</div>
