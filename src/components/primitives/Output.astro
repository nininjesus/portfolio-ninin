---
import '../../styles/components/output.css';
import Cursor from './Cursor.astro';

interface Props {
  text?: string;
  showCursor?: boolean;
}

const { text, showCursor = false } = Astro.props;
---
<div class="cmd-output">
  <span class="cmd-output-symbol" aria-hidden="true">&gt;</span>
  <div class="cmd-output-content">
    {text ? <span>{text}</span> : <slot />}
    {showCursor && <Cursor />}
  </div>
</div>
